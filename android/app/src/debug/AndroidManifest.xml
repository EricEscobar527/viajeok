<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug only: lets the app reach the support API on the dev PC over
         plain http (e.g. http://192.168.x.x:8010). Release builds keep
         Android's default of https only. -->
    <application android:usesCleartextTraffic="true">
        <!-- Replays saved offer screenshots through the trip reader (debug only). -->
        <activity
            android:name=".DebugOfferActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
